abulaire":["school مدرسة","classroom قسم","library مكتبة","teacher أستاذ"],"conseils":["فرّق there is / there are","تدرّب على حروف المكان"],"idee":"الحياة المدرسية"},{"id":"en-mal-5","unite":5,"niveau":"1AS","langue":"en","titre_en":"Food & Drinks","titre_ar":"المأكل والمشرب","grammaire":["some / any","countable / uncountable nouns","would like"],"structures":["I like apples.","There is some bread.","There aren't any tomatoes.","Would you like some tea?"],"vocabulaire":["bread خبز","apple تفاح","milk حليب","water ماء"],"conseils":["some للإثبات و any للنفي والسؤال","would like = يريد بأدب"],"idee":"المأكل والمشرب"},{"id":"en-mal-6","unite":6,"niveau":"1AS","langue":"en","titre_en":"Health & Body","titre_ar":"الصحة والجسم","grammaire":["should / shouldn't (advice)","body parts","imperatives"],"structures":["You should see a doctor.","You shouldn't eat sugar.","Wash your hands.","I have a headache."],"vocabulaire":["headache صداع","doctor طبيب","body جسم","rest راحة"],"conseils":["should للنصيحة","احفظ أعضاء الجسم"],"idee":"الصحة والجسم"},{"id":"en-mal-7","unite":7,"niveau":"1AS","langue":"en","titre_en":"Hobbies & Free Time","titre_ar":"الهوايات وأوقات الفراغ","grammaire":["like/love/enjoy + V-ing","can for ability"],"structures":["I like reading.","She enjoys drawing.","I can play chess.","They don't like cooking."],"vocabulaire":["reading قراءة","swimming سباحة","chess شطرنج","hiking مشي جبلي"],"conseils":["بعد like/love/enjoy نضيف -ing","can لا تتغير"],"idee":"الهوايات وأوقات الفراغ"},{"id":"en-mal-8","unite":8,"niveau":"1AS","langue":"en","titre_en":"Describing People & Places","titre_ar":"وصف الأشخاص والأماكن","grammaire":["adjectives","present continuous","comparatives & superlatives"],"structures":["She is tall.","He is wearing a jacket.","My city is bigger than my village.","It is the most beautiful."],"vocabulaire":["tall طويل","beautiful جميل","old قديم","friendly ودود"],"conseils":["قارن بـ -er + than والأفضلية بـ the most","المستمر be + V-ing"],"idee":"وصف الأشخاص والأماكن"}]}