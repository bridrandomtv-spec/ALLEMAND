 "A_extension_u7":{
  "unite":7,
  "niveau":"3AS",
  "titre":"Persönlichkeit und Identität — extension originale",
  "texte":{
   "titre":"Wer bin ich eigentlich?",
   "corps":"Ich heiße Salim und bin achtzehn Jahre alt. Ich wohne in Blida, am Fuß des Atlasgebirges. Meine Freunde sagen, ich sei ruhig, aber ich lache gern. In meiner Freizeit fotografiere ich die Berge und höre algerische Musik. Manchmal frage ich mich: Wer bin ich eigentlich? Bin ich mein Name, meine Stadt, meine Träume? Ich glaube, ich bin alles zusammen: meine Familie, meine Sprache und meine Wünsche. Deshalb lerne ich Deutsch — um meine Welt einem größeren Publikum zu erzählen.",
   "mots":78
  },
  "exercices":[
   {
    "q":"Wo wohnt Salim?",
    "opts":[
     "In Blida",
     "In Alger",
     "In Oran",
     "In Blida?"
    ],
    "a":0,
    "why":"« Ich wohne in Blida, am Fuß des Atlasgebirges. »"
   },
   {
    "q":"Was macht Salim in seiner Freizeit?",
    "opts":[
     "Er fotografiert und hört Musik",
     "Er spielt Fußball",
     "Er liest Zeitung",
     "Er kocht"
    ],
    "a":0,
    "why":"« Ich fotografiere die Berge und höre algerische Musik. »"
   },
   {
    "q":"Vrai ou faux : Salim lerne Deutsch, um zu reisen.",
    "opts":[
     "Faux : pour raconter sa monde",
     "Vrai",
     "Faux : pour le travail",
     "Faux : pour sa famille"
    ],
    "a":0,
    "why":"« um meine Welt einem größeren Publikum zu erzählen »."
   },
   {
    "q":"« Meine Freunde sagen, ich ___ ruhig. »",
    "opts":[
     "sei",
     "bin",
     "bin?",
     "habe"
    ],
    "a":0,
    "why":"Discours indirect : Konjunktiv I « sei »."
   }
  ]
 },
