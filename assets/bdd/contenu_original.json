   "id":"c02",
   "comp":"haben",
   "regle":"ich habe · du hast · er/sie/es hat · wir haben · ihr habt · sie/Sie haben",
   "exemple":"Ich habe ein Buch.",
   "piege":"Le b tombe à du hast et er hat."
  },
  {
   "id":"c03",
   "comp":"W-Fragen",
   "regle":"wie · wer · wo · woher · wohin · wann · warum",
   "exemple":"Woher kommst du? — Ich komme aus Algerien.",
   "piege":"Ne pas confondre wo (position) / woher (origine) / wohin (direction)."
  },
  {
   "id":"c04",
   "comp":"Akkusativ",
   "regle":"der → den · ein → einen · die/das inchangés",
   "exemple":"Ich sehe den Mann.",
   "piege":"Seuls le masculin singulier change."
  },
  {
   "id":"c05",
   "comp":"Dativ",
   "regle":"der/das → dem · die → der · verbes : helfen, danken, geben",
   "exemple":"Ich helfe dem Freund.",
   "piege":"helfen/danken veulent toujours le Datif."
  },
  {
   "id":"c06",
   "comp":"Perfekt",
   "regle":"haben ou sein + Partizip II ; mouvement/état = sein",
   "exemple":"Ich habe gelernt. / Er ist gekommen.",
   "piege":"Les verbes de mouvement prennent sein."
  },
  {
   "id":"c07",
   "comp":"Position du verbe",
   "regle":"verbe conjugué en 2 position en phrase déclarative",
   "exemple":"Ich spiele jeden Tag Fußball.",
   "piege":"Ne pas placer le sujet après le verbe sauf inversion."
  },
  {
   "id":"c08",
   "comp":"Négation",
   "regle":"nicht (verbe/adjectif) vs kein (nom avec article indéfini)",
   "exemple":"Ich habe kein Buch. / Er kommt nicht.",
   "piege":"kein s'accorde comme ein."
  },
  {
   "id":"c09",
   "comp":"Pronoms",
   "regle":"ich/mich/mir · er/ihn/ihm · sie/sie/ihr",
   "exemple":"Er sieht mich. / Ich helfe ihm.",
   "piege":"Accusatif (objet direct) vs Datif (objet indirect)."
  },
